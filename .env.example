# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - DOCKER
# ==============================================================================
# Para customizar, copie este arquivo para .env:
#   cp .env.example .env

# Porta externa exposta no host (Padrão: 5000)
# Se quiser acessar diretamente pelo IP ou domínio na porta web padrão, use 80:
# PORT=80
PORT=5000

# Concorrência Gunicorn
# Para VPS de 1GB/2GB RAM (1-2 vCPUs): 2 workers e 16 threads (32 conexões simultâneas)
# Para VPS de 4GB RAM (2-4 vCPUs): 4 workers e 16 threads (64 conexões simultâneas)
GUNICORN_WORKERS=4
GUNICORN_THREADS=16

# Timeout para download de mídias longas (em segundos)
GUNICORN_TIMEOUT=300
